project Checks is
   for Source_Dirs use (".", "../src", "../../src");
   for Object_Dir use "obj";
   for Exec_Dir use "bin";
   for Main use ("transport_eval_checks.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf", "-O2", "-g");
   end Compiler;
end Checks;
