project Transport_Bound_Eval_Proof is
   for Source_Dirs use ("src");
   for Source_Files use
     ("transport_eval.ads", "transport_eval.adb",
      "transport_bound_eval.ads", "transport_bound_eval.adb",
      "transport_bound_eval_parse.ads", "transport_bound_eval_parse.adb");
   for Object_Dir use "bound_proof_obj";
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--report=all", "--warnings=error", "-j1");
   end Prove;
end Transport_Bound_Eval_Proof;
