project Transport_Bound_Eval is
   for Languages use ("Ada", "C");
   for Source_Dirs use ("src");
   for Source_Files use
     ("transport_eval.ads", "transport_eval.adb",
      "transport_bound_eval.ads", "transport_bound_eval.adb",
      "transport_bound_eval_parse.ads", "transport_bound_eval_parse.adb",
      "transport_bound_eval_io.ads", "transport_bound_eval_io.adb",
      "transport_bound_eval_native.adb", "transport_bound_eval_file.c");
   for Object_Dir use "bound_obj";
   for Exec_Dir use "bin";
   for Main use ("transport_bound_eval_native.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf",
         "-O2", "-g", "-fstack-usage");
      for Default_Switches ("C") use
        ("-std=c11", "-Wall", "-Wextra", "-Werror", "-Wconversion", "-Wshadow",
         "-Wstrict-prototypes", "-Wmissing-prototypes", "-Wpedantic",
         "-O2", "-g", "-fstack-usage");
   end Compiler;
end Transport_Bound_Eval;
