project Transport_Core is
   for Source_Dirs use ("src", "../src");
   for Object_Dir use external ("TRANSPORT_CORE_OBJ", "core-obj");
   for Exec_Dir use external ("TRANSPORT_CORE_BIN", "core-bin");
   for Main use ("transport_core_native.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf",
         "-O2", "-g", "-fstack-usage");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--report=all", "--warnings=error", "-j1");
   end Prove;
end Transport_Core;
