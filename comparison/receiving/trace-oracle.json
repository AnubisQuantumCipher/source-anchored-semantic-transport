{
  "schema": "transport/public-receiving-trace-oracle/1",
  "status": "FROZEN_LITERAL_EXPECTATIONS_BEFORE_IMPLEMENTATION",
  "contract": {
    "path": "comparison/receiving/contract.json",
    "sha256": "7ea4477e4a51f05c274cbea7cdd5c5b68b08c88f50f2c550f180ca8e088622a2"
  },
  "authorship": "Independent source-authored synthetic data and expected projections. No expected result is obtained from a collector, product checker, live actor or implementation-under-test. Data strings are never executed.",
  "scope": "One public development dry run. Native files and the same ordinary tools are available to both receiving arms. The older handoff-client restrictions and 32-call quota are not adopted. This oracle qualifies metadata projection and retained collector protocol controls; it is not heldout, study, benefit or product acceptance evidence.",
  "historical_sources": [
    {
      "role": "phase_aware_capture",
      "path": "/home/sicarii/Projects/source-anchored-semantic-transport/evidence/semantic-omission-v1/trace-tools-01/capture_trace.py",
      "sha256": "dfa2a0fd39db5eb258ac1ffed6236101a46323489917da624c8fbaf5fe7c2aab"
    },
    {
      "role": "trace_support",
      "path": "/home/sicarii/Projects/source-anchored-semantic-transport/evidence/semantic-omission-v1/trace-tools-01/trace_support.py",
      "sha256": "7c0d3f4730af0bb39df1db6369767c30a8dcd6c81880033b37f079888e5e2add"
    }
  ],
  "projection_contract": {
    "function_boundary": "One already parsed JSON record enters metadata projection. Return exactly expected.projection, including null when ignored, or an explicit bounded refusal. The scanner separately adds line, offset and representation=WHITELISTED_FIELDS_NOT_RAW_RECORD. Metadata comparisons are structural JSON equality; no field may be silently inserted, dropped or coerced.",
    "routes": [
      "outer session_meta with object payload -> SESSION_METADATA; select payload id, session_id, timestamp, cli_version",
      "outer turn_context with object payload -> TURN_MODEL_METADATA; select payload model, model_provider, model_slug, reasoning_effort, effort; no selected keys -> null",
      "outer event_msg with object payload.type task_started or task_complete -> TASK_LIFECYCLE_METADATA; select payload type, started_at, completed_at, duration_ms, time_to_first_token_ms and, when present, outer timestamp as fields.timestamp",
      "outer token_usage_record or token_count with object payload and absent or matching payload.type, or outer event_msg with object payload.type token_count -> OBSERVED_USAGE_RECORD",
      "all other routes, including reasoning and arbitrary payloads with token_count-shaped nested data, -> null without exporting or validating unrelated private fields"
    ],
    "session_strings": "id, session_id and cli_version when present must be nonempty strings of at most 256 Unicode code points. UUID equality and lineage are checked separately. Payload timestamp, when present, must be null or a nonempty string of at most 128 Unicode code points. No date parsing or timestamp subtraction.",
    "model_strings": "Every present recognized model key must be a nonempty string of at most 256 Unicode code points. Null, Boolean, numeric, list and object recognized model values refuse. No normalization, alias resolution or backend-attestation inference.",
    "lifecycle_strings": "started_at and completed_at and outer record timestamp, when present, must be null or nonempty strings of at most 128 Unicode code points. Unknown lifecycle keys are omitted.",
    "timing_values": "duration_ms and time_to_first_token_ms when present must be null or exact JSON integers in [0,9223372036854775807]. Boolean, negative, floating-point, string, list or object recognized timing values refuse. Null remains null and means UNKNOWN, never zero.",
    "usage_scalars": ["input_tokens", "cached_input_tokens", "output_tokens", "reasoning_output_tokens", "total_tokens", "input_token_count", "output_token_count"],
    "usage_groups": ["usage", "thread_token_usage", "turn_token_usage", "total_token_usage", "last_token_usage", "token_usage"],
    "usage_values": "Recognized scalar token fields, direct or inside recognized groups, must be exact JSON integers in [0,9223372036854775807]. Null, Boolean, negative, floating-point, string, list and object recognized scalar values refuse. Each recognized group is null or an object; null remains null and means UNKNOWN. Unknown keys inside a group are omitted, regardless of value. An empty recognized group projects as {}.",
    "usage_containers": "Read direct payload scalar/group fields and optional payload.info scalar/group fields. info must be object or null when present; null is UNKNOWN and contributes no fields. A recognized scalar/group name present in both direct payload and info refuses even if values agree; do not silently overwrite or merge snapshots. A recognized group in an irrelevant record is not a metadata route.",
    "usage_output": "OBSERVED_USAGE_RECORD always carries aggregation=NONE. Keep every admitted observation separately, including identical or decreasing snapshots. Do not sum, subtract, derive missing totals, infer cache ratios, check arithmetic consistency, infer billing or claim actual human work. An eligible usage record with no selected fields projects fields={}.",
    "unknown_fields": "Never export raw session_meta, turn_context, info or lifecycle payloads. Unrecognized fields are ignored; no recursion through arbitrary nested private data. Global JSON framing, duplicate-key, depth and resource controls still apply before projection.",
    "missing_values": "An absent recognized field stays absent. Missing metadata is UNKNOWN in the report policy, not a fabricated null/zero value. Only explicitly admitted null timestamps, timing values and groups remain literal null.",
    "failure": "A malformed recognized value causes CAPTURE_REFUSED or an explicit test-visible projection refusal; it must never be silently omitted to produce a passing capture. Failure reason text need not equal this oracle's category string, but must name the offending category/field. No successful final report may be emitted after refusal.",
    "bounds": {
      "maximum_numeric_value": 9223372036854775807,
      "maximum_model_string_codepoints": 256,
      "maximum_session_identifier_or_cli_codepoints": 256,
      "maximum_timestamp_codepoints": 128,
      "maximum_rollout_bytes": 33554432,
      "maximum_line_bytes": 1048576,
      "maximum_lines": 32768,
      "maximum_tool_events_combined": 768,
      "maximum_metadata_events_including_first_session_meta": 256,
      "maximum_observed_finals": 8,
      "maximum_output_bytes": 4194304,
      "maximum_json_container_depth": 64,
      "maximum_json_object_fields": 1024
    },
    "first_record": "The initial session_meta is both lineage-checked and projected once as SESSION_METADATA. It counts toward the existing 256 metadata-event budget. It is not exported raw. Do not skip its id/CLI fields merely because the scanner consumes it separately for lineage."
  },
