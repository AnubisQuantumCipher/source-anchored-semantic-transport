project Sentinel_Policy_Proof is
   for Source_Dirs use (".");
   for Source_Files use ("sentinel_policy.ads", "sentinel_policy.adb");
   for Object_Dir use external ("DOCUMENT_PROOF_OBJ");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf");
   end Compiler;
   package Prove is
      for Proof_Switches ("Ada") use
        ("--level=2", "--report=all", "--warnings=error", "-j1");
   end Prove;
end Sentinel_Policy_Proof;
