project Sentinel_Policy is
   for Source_Dirs use (".");
   for Source_Files use
     ("sentinel_policy.ads", "sentinel_policy.adb", "sentinel_policy_checks.adb",
      "sentinel_policy_fixtures.ads", "sentinel_policy_fixtures.adb");
   for Object_Dir use external ("DOCUMENT_NATIVE_OBJ");
   for Exec_Dir use external ("DOCUMENT_NATIVE_BIN");
   for Main use ("sentinel_policy_checks.adb");
   package Compiler is
      for Default_Switches ("Ada") use
        ("-gnat2022", "-gnatwa", "-gnatwe", "-gnatVa", "-gnata", "-gnatf",
         "-O2", "-g", "-fstack-usage");
   end Compiler;
end Sentinel_Policy;
